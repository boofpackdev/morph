  "keywords": [
    "pi-package",
    "pi-extension",
    "morph",
    "agent-orchestration",
    "subagent",
    "pipeline",
    "multi-agent",
    "software-development",
    "code-review",
    "ci-cd"
  ],
  "license": "MIT",
  "author": "morph contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boofpackdev/morph.git"
  },
  "bugs": {
    "url": "https://github.com/boofpackdev/morph/issues"
  },
  "homepage": "https://github.com/boofpackdev/morph#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/",
    "agents/",
    "prompts/",
    "bin/",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "morph": "bin/morph.js"
  },
  "dependencies": {
    "ws": "^8.20.1",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
